{
  "name": "nav-map-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter demo dev",
    "build": "pnpm --filter @neonwatty/nav-map build && pnpm --filter demo build",
    "build:core": "pnpm --filter @neonwatty/nav-map build",
    "lint": "eslint packages/*/src/",
    "lint:fix": "eslint packages/*/src/ --fix",
    "test": "pnpm --filter @neonwatty/nav-map test && pnpm --filter @neonwatty/nav-map-scanner test",
    "typecheck": "pnpm -r typecheck",
    "scanner:help": "node packages/scanner/bin/nav-map.js --help",
    "reliability:agent": "node scripts/agent-reliability-gate.mjs",
    "smoke:skill": "node scripts/nav-map-skill-smoke.mjs",
    "smoke:package-consumer": "node scripts/package-consumer-smoke.mjs",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css}\"",
    "knip": "knip",
    "knip:production": "knip --production",
    "smoke:demo": "pnpm --filter @neonwatty/nav-map-scanner exec node ../../scripts/demo-smoke.mjs",
    "validate": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm knip:production && pnpm build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "knip": "^5.87.0",
    "prettier": "^3.8.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.13.1"
}
